---
import { Icon } from 'astro-icon/components';

const links = [
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/skills/', label: 'Skills' },
  { href: '/projects/', label: 'Projects' },
  { href: '/dashboards/', label: 'Dashboards' },
  { href: '/education/', label: 'Education' },
  { href: '/contact/', label: 'Contact' }
];
// normalise so /about and /about/ both match
const current = Astro.url.pathname.replace(/\/?$/, '/');
---
<nav class="navbar" id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Eliya Abbas, home">
      <img src="/logo.webp" alt="Eliya Abbas logo" height="32" width="32" style="border-radius: 6px;" />
    </a>
    <ul class="nav-links" id="navLinks">
      {links.map((l) => (
        <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href="/Eliya_Abbas_Resume.pdf" class="btn btn-primary nav-cta" data-resume-open>
        <Icon name="lucide:file-text" size={16} /> <span>Resume</span>
      </a>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
        <span class="icon-moon"><Icon name="lucide:moon" size={18} /></span>
        <span class="icon-sun"><Icon name="lucide:sun" size={18} /></span>
      </button>
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav-logo {
    display: flex;
    align-items: center;
    transition: var(--transition);
  }
  .nav-logo:hover {
    transform: scale(1.05);
  }
</style>
