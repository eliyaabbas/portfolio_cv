---
import { Icon } from 'astro-icon/components';
---
<section class="section" id="contact">
  <div class="section-inner">
    <span class="section-label">Let's Connect</span>
    <h2 class="section-title reveal">Get in Touch</h2>
    <p class="section-desc reveal">Have a project idea or want to collaborate? Feel free to reach out.</p>
    <div class="contact-grid" style="grid-template-columns: 1fr; max-width: 600px; margin: 0 auto;">
      <div class="contact-info" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
        <a class="contact-item reveal" href="mailto:eliyaasayyed@gmail.com">
          <div class="c-icon"><Icon name="lucide:mail" size={20} /></div>
          <span>eliyaasayyed@gmail.com</span>
        </a>
        <a class="contact-item reveal" href="https://www.linkedin.com/in/eliyaa" target="_blank">
          <div class="c-icon"><Icon name="simple-icons:linkedin" size={20} /></div>
          <span>linkedin.com/in/eliyaa</span>
        </a>
        <a class="contact-item reveal" href="https://github.com/eliyaabbas" target="_blank">
          <div class="c-icon"><Icon name="simple-icons:github" size={20} /></div>
          <span>github.com/eliyaabbas</span>
        </a>
        <div class="contact-item reveal">
          <div class="c-icon"><Icon name="lucide:map-pin" size={20} /></div>
          <span>Mumbai, India</span>
        </div>
      </div>
    </div>
  </div>
</section>
