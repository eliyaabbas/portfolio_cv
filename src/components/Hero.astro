---
import { Icon } from 'astro-icon/components';
import ThreeVisual from './ThreeVisual.astro';
---
<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge"><span class="pulse"></span> Available for Opportunities</div>
      <h1>Hi, I'm <span class="gradient">Eliya Abbas</span></h1>
      <p class="subtitle">
        <span class="typing-text">Software Engineer</span><span style="color: var(--accent-cyan);">|</span>
      </p>
      <p class="subtitle" style="margin-top: -1rem;">
        AI Engineer & Data Scientist focused on <strong>LLM evaluation</strong>, Generative AI and reliable AI systems.
      </p>
      <div class="hero-cta">
        <a href="/Eliya_Abbas_Resume.pdf" class="btn btn-primary" data-resume-open><Icon name="lucide:file-text" size={18} /> View Resume</a>
        <button type="button" class="btn btn-outline" data-chat-open><Icon name="lucide:sparkles" size={18} /> Ask my AI</button>
        <a href="#projects" class="btn btn-outline"><Icon name="lucide:zap" size={18} /> View Projects</a>
        <a href="#contact" class="btn btn-outline"><Icon name="lucide:mail" size={18} /> Get in Touch</a>
        <a href="https://github.com/eliyaabbas" target="_blank" rel="noopener noreferrer" class="btn btn-outline"><Icon name="simple-icons:github" size={18} /> GitHub</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <div class="stat-number counter" data-count="24" data-suffix="+">0+</div>
          <div class="stat-label">Projects</div>
        </div>
        <div class="stat">
          <div class="stat-number counter" data-count="20" data-suffix="+">0+</div>
          <div class="stat-label">Technologies</div>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="avatar-wrapper">
        <div class="avatar-ring"></div>
        <div class="visual-container">
          <ThreeVisual />
          <img src="/avatar.webp" alt="Portrait of Eliya Abbas, AI Engineer and Data Scientist" width="1024" height="1024" fetchpriority="high" decoding="async" class="avatar-img-overlay" />
        </div>
      </div>
    </div>

<style>
  .visual-container {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-img-overlay {
    width: 75%;
    height: 75%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--accent-cyan);
    z-index: 2;
    box-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
    position: absolute;
  }
</style>
  </div>
</section>
