---
import { Icon } from 'astro-icon/components';

const dashboards = [
  {
    title: "IBM HR Analytics",
    desc: "Comprehensive HR dashboard analyzing employee attrition, satisfaction, and demographic trends.",
    views: 145,
    link: "https://public.tableau.com/app/profile/eliya.sayyed/viz/IBMHRAnalytics_17591437422950/Dashboard4",
    thumbnail: "https://public.tableau.com/static/images/IB/IBMHRAnalytics_17591437422950/Dashboard4/4_3.png"
  },
  {
    title: "Customer Trial Data",
    desc: "Analytical report on customer trial conversions and behavioral patterns.",
    views: 35,
    link: "https://public.tableau.com/app/profile/eliya.sayyed/viz/CustomerTrialData/TrialCustomerReport",
    thumbnail: "https://public.tableau.com/static/images/Cu/CustomerTrialData/TrialCustomerReport/4_3.png"
  },
  {
    title: "Amazon Prime OTT Dashboard",
    desc: "Content analysis and viewership trends for Amazon Prime Video.",
    views: 32,
    link: "https://public.tableau.com/app/profile/eliya.sayyed/viz/AmazonPrimeOttDashboard/Dashboard1",
    thumbnail: "https://public.tableau.com/static/images/Am/AmazonPrimeOttDashboard/Dashboard1/4_3.png"
  },
  {
    title: "Netflix Analysis",
    desc: "Deep dive into Netflix content distribution and genre trends.",
    views: 30,
    link: "https://public.tableau.com/app/profile/eliya.sayyed/viz/Netflix_17311115689570/Dashboard1",
    thumbnail: "https://public.tableau.com/static/images/Ne/Netflix_17311115689570/Dashboard1/4_3.png"
  },
  {
    title: "NetFlix OTT Tableau",
    desc: "Comparative analysis of OTT content metrics using Tableau.",
    views: 32,
    link: "https://public.tableau.com/app/profile/eliya.sayyed/viz/NetFlixOTTtableau/Dashboard1",
    thumbnail: "https://public.tableau.com/static/images/Ne/NetFlixOTTtableau/Dashboard1/4_3.png"
  }
];
---

<section class="section" id="tableau">
  <div class="section-inner">
    <span class="section-label">Data Visualizations</span>
    <h2 class="section-title reveal">Tableau Dashboards</h2>
    <p class="section-desc reveal">Interactive business intelligence dashboards and data stories built using Tableau Public.</p>
    
    <div class="tableau-grid">
      {dashboards.map((dash) => (
        <div class="tableau-card reveal">
          <div class="tableau-img-wrapper">
            <img src={dash.thumbnail} alt={dash.title} loading="lazy" />
            <div class="tableau-overlay">
              <a href={dash.link} target="_blank" class="btn btn-primary">
                <Icon name="lucide:external-link" size={18} />
                View Dashboard
              </a>
            </div>
          </div>
          <div class="tableau-content">
            <div class="tableau-meta">
              <h3>{dash.title}</h3>
              <div class="tableau-stats">
                <Icon name="lucide:eye" size={14} />
                <span>{dash.views}</span>
              </div>
            </div>
            <p>{dash.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tableau-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .tableau-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: var(--transition);
  }
  .tableau-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow);
  }
  .tableau-img-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .tableau-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }
  .tableau-card:hover .tableau-img-wrapper img {
    transform: scale(1.05);
  }
  .tableau-overlay {
    position: absolute;
    inset: 0;
    background: rgba(6, 8, 13, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
    backdrop-filter: blur(4px);
  }
  .tableau-card:hover .tableau-overlay {
    opacity: 1;
  }
  .tableau-content {
    padding: 1.5rem;
  }
  .tableau-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.8rem;
    gap: 1rem;
  }
  .tableau-meta h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .tableau-stats {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    font-size: 0.8rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .tableau-content p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .tableau-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
