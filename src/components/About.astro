---
import { Icon } from 'astro-icon/components';
---
<section class="section" id="about">
  <div class="section-inner">
    <span class="section-label">Who I Am</span>
    <h2 class="section-title reveal">About Me</h2>
    <div class="about-grid">
      <div class="about-text reveal">
        <p>
          I'm <strong>Eliya Abbas Sayyed</strong>, a Software Engineer and Data Analyst currently working as a 
          <strong>Full Stack Developer at Innoviscent LPP</strong>. I specialize in building modern web applications 
          and extracting actionable insights from data using Python, SQL, and BI tools.
        </p>
        <p>
          With a strong foundation in <strong>AI/ML from Mumbai University</strong> and hands-on experience across 
          the full stack — from React frontends to Node.js backends and databases like MongoDB, PostgreSQL, and MySQL — 
          I bridge the gap between data analytics and software engineering.
        </p>
        <p>
          I'm passionate about <strong>vibe coding with AI tools</strong>, leveraging GPT Codex, Claude Code, and 
          Gemini CLI to accelerate development while maintaining clean, production-grade code.
        </p>
      </div>
      <div class="info-cards">
        <div class="info-card reveal">
          <div class="icon purple"><Icon name="lucide:briefcase" size={20} /></div>
          <div class="info-card-content">
            <h4>Current Role</h4>
            <p>Full Stack Developer @ Innoviscent LPP</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon cyan"><Icon name="lucide:map-pin" size={20} /></div>
          <div class="info-card-content">
            <h4>Location</h4>
            <p>Mumbai, India</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon pink"><Icon name="lucide:graduation-cap" size={20} /></div>
          <div class="info-card-content">
            <h4>Education</h4>
            <p>B.E CSE (AI & ML) — Mumbai University</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon green"><Icon name="lucide:bot" size={20} /></div>
          <div class="info-card-content">
            <h4>Focus Areas</h4>
            <p>Full Stack, Data Analytics, GenAI & ML</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
