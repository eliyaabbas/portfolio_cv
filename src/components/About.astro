---
import { Icon } from 'astro-icon/components';
---
<section class="section" id="about">
  <div class="section-inner">
    <span class="section-label">Who I Am</span>
    <h2 class="section-title reveal">About Me</h2>
    <div class="about-grid">
      <div class="about-text reveal">
        <p>
          I'm <strong>Eliya Abbas Sayyed</strong>, an <strong>AI Solutions Architect</strong> and Data Analytics Expert currently working as a 
          <strong>Software Engineer at Innoviscent LPP</strong>. With a proven track record across <strong>Intelihuman.com</strong>, 
          <strong>The SkyBrisk</strong>, and <strong>Codsoft</strong>, I specialize in building end-to-end production AI pipelines, 
          leveraging <strong>Agentic AI</strong> and <strong>Retrieval-Augmented Generation (RAG)</strong> to solve complex business problems.
        </p>
        <p>
          With a strong foundation in <strong>AI/ML from Mumbai University</strong>, I focus on <strong>Decision Intelligence</strong> — 
          bridging the gap between raw unstructured data and actionable insights using Python, SQL, and advanced BI orchestration.
        </p>
        <p>
          I'm passionate about <strong>Generative AI optimization</strong> and the <strong>Vibe Coding</strong> movement — 
          using <strong>Model Context Protocol (MCP)</strong> to accelerate software engineering without compromising on 
          architectural integrity. I believe that <strong>Core Knowledge + AI Orchestration</strong> is the key to 
          high-velocity, production-grade software delivery in the modern era.
        </p>
      </div>
      <div class="info-cards">
        <div class="info-card reveal">
          <div class="icon purple"><Icon name="lucide:briefcase" size={20} /></div>
          <div class="info-card-content">
            <h4>Current Role</h4>
            <p>Software Engineer @ Innoviscent LPP</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon cyan"><Icon name="lucide:map-pin" size={20} /></div>
          <div class="info-card-content">
            <h4>Location</h4>
            <p>Mumbai, India</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon pink"><Icon name="lucide:graduation-cap" size={20} /></div>
          <div class="info-card-content">
            <h4>Education</h4>
            <p>B.E CSE (AI & ML) — Mumbai University</p>
          </div>
        </div>
        <div class="info-card reveal">
          <div class="icon green"><Icon name="lucide:bot" size={20} /></div>
          <div class="info-card-content">
            <h4>Focus Areas</h4>
            <p>Full Stack, Data Analytics, GenAI & ML</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
