---
import { Icon } from 'astro-icon/components';

// Static project data with repo names for matching
const featuredProjects = [
  {
    repo: "DeFi_Credit_Coring_Model",
    title: "DeFi Agentic Credit Scorer",
    desc: "End-to-end production pipeline assigning 0–1000 credit scores to Aave V2 wallets using unsupervised KMeans clustering on raw DeFi transaction data for decision intelligence.",
    tech: ["Python", "KMeans", "DeFi", "Financial AI"],
    icon: "lucide:landmark"
  },
  {
    repo: "LiveRestaurantMenu",
    title: "Real-time Service Orchestration",
    desc: "A scalable digital service platform with real-time menu management, featuring production-grade API design and secure administrative workflows.",
    tech: ["Node.js", "MongoDB", "Service Design"],
    icon: "lucide:utensils-crossed"
  },
  {
    repo: "SkyBricks-Project4-Movie-Recommender",
    title: "NLP Recommender Engine",
    desc: "Content-aware recommendation engine utilizing NLP-based feature extraction and collaborative filtering for high-precision user targeting.",
    tech: ["Python", "NLP", "Scikit-learn"],
    icon: "lucide:film"
  },
  {
    repo: "Internshala_BI_Projects",
    title: "Decision Intelligence Dashboards",
    desc: "Advanced BI orchestration using Excel, Power BI, and Python to transform complex datasets into actionable decision-making frameworks.",
    tech: ["Power BI", "SQL", "Analytics"],
    icon: "lucide:pie-chart"
  },
  {
    repo: "Risk_Score",
    title: "On-chain Risk Assessment",
    desc: "Statistical risk scoring engine for Ethereum wallets, analyzing on-chain behavior to assess reliability and protocol safety.",
    tech: ["Python", "Blockchain", "Statistics"],
    icon: "lucide:alert-triangle"
  },
  {
    repo: "Predictive-Employee-Attrition-Model",
    title: "Predictive HR Analytics",
    desc: "Predictive ML model for employee churn analysis, utilizing classification algorithms to drive data-driven retention strategies.",
    tech: ["Python", "ML", "HR Tech"],
    icon: "lucide:users"
  },
  {
    repo: "TitanicSurvivalPrediction",
    title: "Classification Core Model",
    desc: "Supervised learning implementation for predictive classification, focused on feature engineering and model accuracy optimization.",
    tech: ["Python", "Classification", "ML"],
    icon: "lucide:ship"
  },
  {
    repo: "PortfolioAI",
    title: "Agentic Portfolio Assistant",
    desc: "An RAG-powered AI assistant for codebase intelligence and interactive user engagement, built with modern LLM orchestration.",
    tech: ["LLM", "RAG", "Agentic AI"],
    icon: "lucide:bot"
  }
];

const GITHUB_USERNAME = "eliyaabbas";
let projects = [];

try {
  const response = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`);
  if (response.ok) {
    const repos = await response.json();
    
    // Merge GitHub data with featured projects
    projects = featuredProjects.map(featured => {
      const repoData = repos.find(r => r.name.toLowerCase() === featured.repo.toLowerCase());
      return {
        ...featured,
        link: repoData?.html_url || `https://github.com/${GITHUB_USERNAME}/${featured.repo}`,
        stars: repoData?.stargazers_count || 0,
        language: repoData?.language
      };
    });

    // Sort by stars first, then by the original order
    projects.sort((a, b) => (b.stars || 0) - (a.stars || 0));
  } else {
    throw new Error('GitHub API response not ok');
  }
} catch (e) {
  // Fallback to static data if API fails
  projects = featuredProjects.map(f => ({
    ...f,
    link: `https://github.com/${GITHUB_USERNAME}/${f.repo}`,
    stars: 0
  }));
}
---
<section class="section" id="projects">
  <div class="section-inner">
    <span class="section-label">My Work</span>
    <h2 class="section-title reveal">Featured Projects</h2>
    <p class="section-desc reveal">A curated selection of projects showcasing my technical breadth, now synced with GitHub.</p>
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card reveal">
          <div class="project-header">
            <div class="project-icon">
              <Icon name={project.icon} size={24} />
            </div>
            <div class="project-links">
              {project.stars > 0 && (
                <span class="project-stars">
                  <Icon name="lucide:star" size={16} />
                  {project.stars}
                </span>
              )}
              <a href={project.link} target="_blank" title="GitHub"><Icon name="lucide:external-link" size={20} /></a>
            </div>
          </div>
          <h3>{project.title}</h3>
          <p>{project.desc}</p>
          <div class="project-tech">
            {project.tech.map((t) => <span>{t}</span>)}
          </div>
        </div>
      ))}
    </div>
    <div class="projects-more reveal">
      <a href={`https://github.com/${GITHUB_USERNAME}?tab=repositories`} target="_blank" class="btn btn-outline">
        <Icon name="simple-icons:github" size={18} /> View More on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .projects-more {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }
  .project-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-right: 8px;
  }
  .project-stars :global(svg) {
    color: #ffb400;
  }
</style>
