---
import { Icon } from 'astro-icon/components';
---
<section class="section" id="skills">
  <div class="section-inner">
    <span class="section-label">What I Use</span>
    <h2 class="section-title reveal">Technical Skills</h2>
    <p class="section-desc reveal">Technologies and tools I work with to build, analyze, and deploy.</p>
    <div class="skills-categories">
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(124,58,237,0.12); color:var(--accent-purple);"><Icon name="simple-icons:python" size={20} /></div>
          <h3>Languages & Core</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Python</span>
          <span class="skill-tag">JavaScript</span>
          <span class="skill-tag">SQL</span>
          <span class="skill-tag">MySQL</span>
          <span class="skill-tag">HTML / CSS</span>
        </div>
      </div>
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(0,212,255,0.12); color:var(--accent-cyan);"><Icon name="simple-icons:react" size={20} /></div>
          <h3>Frontend & Backend</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">React.js</span>
          <span class="skill-tag">Node.js</span>
          <span class="skill-tag">REST APIs</span>
          <span class="skill-tag">Postman</span>
        </div>
      </div>
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(236,72,153,0.12); color:var(--accent-pink);"><Icon name="lucide:database" size={20} /></div>
          <h3>Databases & Cloud</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">MongoDB</span>
          <span class="skill-tag">PostgreSQL</span>
          <span class="skill-tag">Supabase</span>
          <span class="skill-tag">Vercel</span>
          <span class="skill-tag">Render</span>
        </div>
      </div>
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(245,158,11,0.12); color:var(--accent-orange);"><Icon name="lucide:bar-chart-3" size={20} /></div>
          <h3>Data & Analytics</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Excel</span>
          <span class="skill-tag">Power BI</span>
          <span class="skill-tag">Tableau</span>
          <span class="skill-tag">CTEs & Joins</span>
        </div>
      </div>
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(16,185,129,0.12); color:var(--accent-green);"><Icon name="lucide:cpu" size={20} /></div>
          <h3>AI & Dev Tools</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">GenAI</span>
          <span class="skill-tag">GPT Codex</span>
          <span class="skill-tag">Claude Code</span>
          <span class="skill-tag">Gemini CLI</span>
          <span class="skill-tag">Antigravity</span>
          <span class="skill-tag">Vibe Coding</span>
        </div>
      </div>
      <div class="skill-category reveal">
        <div class="skill-category-header">
          <div class="cat-icon" style="background:rgba(124,58,237,0.12); color:var(--accent-purple);"><Icon name="lucide:settings" size={20} /></div>
          <h3>DevOps & Tools</h3>
        </div>
        <div class="skill-tags">
          <span class="skill-tag">Git</span>
          <span class="skill-tag">Docker</span>
          <span class="skill-tag">CLI</span>
          <span class="skill-tag">GitHub Actions</span>
        </div>
      </div>
    </div>
  </div>
</section>
