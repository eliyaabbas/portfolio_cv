---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ResumeModal from '../components/ResumeModal.astro';

interface Props {
	title: string;
	description: string;
	heading: string;
	crumb: string;
}

const { title, description, heading, crumb } = Astro.props;
const SITE = 'https://eliyaasayyed.works';

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE}/` },
    { "@type": "ListItem", "position": 2, "name": crumb, "item": new URL(Astro.url.pathname, SITE).href }
  ]
};
---
<Layout title={title} description={description}>
	<Navbar />
	<main class="page-main">
		<!-- Visually hidden page heading; the visible section title below is the h2 -->
		<h1 class="sr-only">{heading}</h1>
		<slot />
	</main>
	<Footer />
	<ResumeModal />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
</Layout>
