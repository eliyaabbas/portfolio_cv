---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
    image?: string;
}

const { 
  title = "Eliya Abbas Sayyed | AI Solutions Architect & Data Analytics Expert", 
  description = "Portfolio of Eliya Abbas Sayyed — AI Solutions Architect specializing in Agentic AI, RAG, and Machine Learning. Expert in Decision Intelligence and Big Data Analytics at Innoviscent LPP.",
  image = "/logo.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://eliyaabbas.com");

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Eliya Abbas Sayyed",
  "url": "https://eliyaabbas.com",
  "image": "https://eliyaabbas.com/avatar.png",
  "jobTitle": "AI Solutions Architect & Software Engineer",
  "description": "Specializing in Agentic Workflows, Retrieval-Augmented Generation (RAG), and Decision Intelligence. Building end-to-end production AI pipelines.",
  "worksFor": {
    "@type": "Organization",
    "name": "Innoviscent LPP",
    "url": "https://innoviscent.com"
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "Machine Learning",
    "Generative AI",
    "Agentic Workflows",
    "RAG (Retrieval-Augmented Generation)",
    "Data Analytics",
    "Decision Intelligence",
    "Python",
    "React",
    "Node.js",
    "Business Intelligence"
  ],
  "sameAs": [
    "https://github.com/eliyaabbas",
    "https://www.linkedin.com/in/eliyaa"
  ]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		
        <!-- SEO Metadata -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Eliya Abbas Sayyed, AI Solutions Architect, Machine Learning Engineer, Data Analytics Expert, Agentic AI, RAG, GenAI, Decision Intelligence, Software Engineer Mumbai, Innoviscent LPP, Intelihuman.com, The SkyBrisk, Codsoft, Python AI Developer, LLM Integration" />
		<link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="profile" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(image, canonicalURL)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

        <!-- Structured Data -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<div class="bg-orbs">
			<div class="orb"></div>
			<div class="orb"></div>
			<div class="orb"></div>
		</div>
		<slot />
		<script src="../scripts/main.js"></script>
	</body>
</html>
