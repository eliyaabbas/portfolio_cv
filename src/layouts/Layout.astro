---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const SITE = "https://eliyaasayyed.works";

const {
  title = "Eliya Abbas | AI Engineer, Data Scientist & LLM Evaluation",
  description = "Portfolio of Eliya Abbas — AI Engineer and Data Scientist specializing in Generative AI, LLM Evaluation and Benchmarking, Machine Learning, and Python/FastAPI systems. Software Engineer at Innoviscent LLP, Mumbai.",
  image = "/og-image.jpg",
  noindex = false
} = Astro.props;

// Google Tag Manager container ID. Container IDs are public (visible in page source), so a default is safe;
// set PUBLIC_GTM_ID to override it, or to an empty string to disable tracking.
const GTM_ID = import.meta.env.PUBLIC_GTM_ID ?? 'GTM-WP7467JR';

const canonicalURL = new URL(Astro.url.pathname, SITE);
const imageURL = new URL(image, SITE).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      "url": SITE,
      "name": "Eliya Abbas — Portfolio",
      "inLanguage": "en",
      "publisher": { "@id": `${SITE}/#person` }
    },
    {
      "@type": "ProfilePage",
      "@id": `${SITE}/#profilepage`,
      "url": SITE,
      "name": title,
      "isPartOf": { "@id": `${SITE}/#website` },
      "about": { "@id": `${SITE}/#person` },
      "primaryImageOfPage": { "@type": "ImageObject", "url": imageURL, "width": 1200, "height": 630 }
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      "name": "Eliya Abbas",
      "url": SITE,
      "image": `${SITE}/avatar.webp`,
      "jobTitle": "Software Engineer",
      "description": "AI Engineer and Data Scientist focused on Generative AI, LLM evaluation and benchmarking (Terminal-Bench, SWE-Bench), machine learning and full-stack AI applications.",
      "worksFor": { "@type": "Organization", "name": "Innoviscent LLP" },
      "address": { "@type": "PostalAddress", "addressLocality": "Mumbai", "addressRegion": "Maharashtra", "addressCountry": "IN" },
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "M.H. Saboo Siddik College of Engineering" }
      ],
      "knowsLanguage": ["English", "Hindi", "Marathi"],
      "knowsAbout": [
        "Artificial Intelligence",
        "Machine Learning",
        "Generative AI",
        "LLM Evaluation",
        "AI Benchmarking",
        "Prompt Engineering",
        "Data Science",
        "Python",
        "FastAPI",
        "React",
        "Node.js",
        "Tableau",
        "Power BI",
        "Business Intelligence"
      ],
      "sameAs": [
        "https://github.com/eliyaabbas",
        "https://www.linkedin.com/in/eliyaa"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#06080d" />
		<meta name="color-scheme" content="dark light" />
		<script is:inline>
			try { var t = localStorage.getItem("theme"); if (t === "light") document.documentElement.setAttribute("data-theme", "light"); } catch (e) {}
		</script>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

        <!-- SEO Metadata -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Eliya Abbas" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
		<meta name="keywords" content="Eliya Abbas, AI Engineer, Data Scientist, LLM Evaluation, AI Benchmarking, Generative AI, Machine Learning, Python, FastAPI, Software Engineer Mumbai, Innoviscent LLP, AirDawg Labs, Terminal-Bench, SWE-Bench" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/pdf" href="/Eliya_Abbas_Resume.pdf" title="Eliya Abbas — Resume (PDF)" />

        <!-- Open Graph -->
		<meta property="og:site_name" content="Eliya Abbas — Portfolio" />
		<meta property="og:locale" content="en_IN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="profile" />
		<meta property="profile:first_name" content="Eliya" />
		<meta property="profile:last_name" content="Abbas" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Eliya Abbas — AI Engineer and Data Scientist" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageURL} />
        <meta name="twitter:image:alt" content="Eliya Abbas — AI Engineer and Data Scientist" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="image" href="/avatar.webp" type="image/webp" />
		<!-- Non-blocking font stylesheet: system fonts render first, web fonts swap in -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" /></noscript>

		{GTM_ID && (
			<script is:inline define:vars={{ GTM_ID }}>
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				// load GTM after the page has loaded so it never competes with first paint
				window.addEventListener('load', function () {
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
					document.head.appendChild(s);
				});
			</script>
		)}

        <!-- Structured Data -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body>
		{GTM_ID && (
			<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
		)}
		<div class="bg-orbs">
			<div class="orb"></div>
			<div class="orb"></div>
			<div class="orb"></div>
		</div>
		<slot />
		<script src="../scripts/main.js"></script>
	</body>
</html>
